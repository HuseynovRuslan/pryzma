# /opt/meydan/.env — the ONLY place production secrets live (chmod 600, owner deploy). Never committed.
# deploy/scripts/init-env.sh writes this file with generated values; this example documents the keys.

# PostgreSQL (own container, no published port)
POSTGRES_PASSWORD=            # bootstrap superuser; used once by db/init, then only for maintenance
APP_DB_NAME=meydan
APP_DB_USER=meydan            # least-privilege application role
APP_DB_PASSWORD=

# Networking
SHARED_PROXY_NETWORK=attendanceqr_default   # the reverse proxy's network (external; created by the QRLog stack)
APP_HTTP_PORT=8040                          # loopback-only diagnostics port on the VPS

# Application
IMAGE_TAG=local                             # set by deploy.sh to the release id
Jwt__SigningKey=                            # >= 32 random characters; new for production, never the dev key
App__PublicUrl=https://meydan.qrlog.az
AllowedHosts=meydan.qrlog.az;localhost;meydan-api
ReverseProxy__KnownNetworks__0=172.16.0.0/12

# E-mail: Disabled until a provider exists; then Smtp + the values below (no code change, restart api).
Email__Mode=Disabled
Email__FromAddress=
Email__FromName=MEYDAN
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__Security=StartTls
Email__Smtp__Username=
Email__Smtp__Password=

# "QRLog ilə daxil ol" — enable once QRLog's ExternalSignInController is deployed with the same secret.
QrlogSso__Enabled=false
QrlogSso__VouchSecret=
QrlogSso__AuthorizeUrl=https://app.qrlog.az/signin/meydan?code={code}&return={return}

# First admin — read by the migrate step only, and only creates the account when that e-mail has none.
Seed__AdminEmail=
Seed__AdminPassword=
